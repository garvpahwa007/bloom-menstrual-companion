{
  "name": "bloom-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "db:dev": "npm --workspace backend run db:dev",
    "build": "npm --workspace frontend run build",
    "start": "npm --workspace backend start",
    "preview": "npm --workspace frontend run start",
    "test": "npm run test:ask && npm run test:frontend && npm run test:backend",
    "test:ask": "node --test api/ask.test.js",
    "test:frontend": "npm --workspace frontend test",
    "test:backend": "npm --workspace backend test",
    "test:postman": "npm --workspace backend run test:postman"
  },
  "engines": {
    "node": ">=20.19"
  }
}
